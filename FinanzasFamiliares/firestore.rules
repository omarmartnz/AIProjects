rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all to prevent unmapped access
    match /{document=**} {
      allow read, write: if false;
    }

    // Per-user profile document: strictly isolated to the authenticated user
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Ephemeral single-use 256-bit family invites registry:
    // Disallows list/scraping. Only allows get by exact token for atomic redemption.
    // Creates restricted to authenticated creator with active & unused status.
    match /invites/{token} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null &&
        request.resource.data.token == token &&
        request.resource.data.creatorUid == request.auth.uid &&
        request.resource.data.used == false &&
        request.resource.data.status == 'active' &&
        request.resource.data.familyId is string &&
        request.resource.data.expiresAt is int &&
        request.resource.data.expiresAt > request.time.toMillis() &&
        exists(/databases/$(database)/documents/families/$(request.resource.data.familyId)) &&
        (
          get(/databases/$(database)/documents/families/$(request.resource.data.familyId)).data.ownerId == request.auth.uid ||
          (
            get(/databases/$(database)/documents/families/$(request.resource.data.familyId)).data.parentUids != null &&
            request.auth.uid in get(/databases/$(database)/documents/families/$(request.resource.data.familyId)).data.parentUids
          )
        );

      allow update: if request.auth != null &&
        // Immutable fields cannot be altered
        request.resource.data.token == resource.data.token &&
        request.resource.data.familyId == resource.data.familyId &&
        request.resource.data.creatorUid == resource.data.creatorUid &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.expiresAt == resource.data.expiresAt &&
        (
          // Creator can revoke active invite
          (
            request.auth.uid == resource.data.creatorUid &&
            resource.data.used == false &&
            resource.data.status == 'active' &&
            request.resource.data.used == true &&
            request.resource.data.status == 'revoked'
          ) ||
          // Invite redemption: single-use transition active -> used by authenticated redeemer
          (
            resource.data.used == false &&
            resource.data.status == 'active' &&
            request.resource.data.used == true &&
            request.resource.data.status == 'used' &&
            request.resource.data.usedByUid == request.auth.uid
          )
        );

      allow delete: if request.auth != null && (
        resource.data.creatorUid == request.auth.uid ||
        (
          resource.data.familyId is string &&
          exists(/databases/$(database)/documents/families/$(resource.data.familyId)) &&
          get(/databases/$(database)/documents/families/$(resource.data.familyId)).data.ownerId == request.auth.uid
        )
      );
    }

    // Family workspaces: Zero-Trust isolation
    match /families/{familyId} {
      // Strictly isolate reading to registered family members and owner only
      allow get: if request.auth != null && (
        resource.data.ownerId == request.auth.uid ||
        (resource.data.memberUids != null && request.auth.uid in resource.data.memberUids)
      );

      // Strictly deny listing across all families to prevent enumeration or unauthorized discovery
      allow list: if false;

      // Allow create by authenticated user who is designated as the owner
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;

      // Allow update if user is already a member/owner, or joining with an active unexpired invite token
      allow update: if request.auth != null &&
        request.resource.data.ownerId == resource.data.ownerId &&
        (
          request.auth.uid == resource.data.ownerId ||
          request.resource.data.parentUids == resource.data.parentUids
        ) &&
        (
          resource.data.ownerId == request.auth.uid ||
          (resource.data.memberUids != null && request.auth.uid in resource.data.memberUids) ||
          (
            request.resource.data.memberUids != null &&
            request.auth.uid in request.resource.data.memberUids &&
            request.resource.data.lastRedeemedToken != null &&
            exists(/databases/$(database)/documents/invites/$(request.resource.data.lastRedeemedToken)) &&
            get(/databases/$(database)/documents/invites/$(request.resource.data.lastRedeemedToken)).data.familyId == familyId &&
            get(/databases/$(database)/documents/invites/$(request.resource.data.lastRedeemedToken)).data.used == false &&
            get(/databases/$(database)/documents/invites/$(request.resource.data.lastRedeemedToken)).data.status == 'active' &&
            get(/databases/$(database)/documents/invites/$(request.resource.data.lastRedeemedToken)).data.expiresAt > request.time.toMillis()
          )
        );

      // Allow delete strictly by family owner
      allow delete: if request.auth != null && request.auth.uid == resource.data.ownerId;
    }
  }
}
